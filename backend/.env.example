# Copy to backend/.env for local (non-Docker) runs.
DATABASE_URL=postgresql+psycopg2://astra:astra@localhost:5432/astrasynth

# Optional. Without it, mission reports fall back to the deterministic
# template - every number is identical, only the prose is missing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Terrain interpretation. Set these from the sidecar JSON that
# scripts/prepare_usgs_terrain.py writes when using real USGS DEM tiles.
METERS_PER_PIXEL=2.0
ELEVATION_RANGE_M=40.0

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional shared secret for the whole HTTP surface. Empty means every endpoint
# is open, which is what the offline demo and CI rely on. Set it and the API
# requires it on every request except /health, /ready and /docs. At least 16
# characters, or the process refuses to start:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# The dashboard does not send it - inject it at the proxy. See docs/operations.md.
API_KEY=

# --- Background jobs --------------------------------------------------------
# Worker threads inside the API process. 0 when workers run as their own
# deployment (`python -m app.worker --workers N`); the queue is a table, so the
# two arrangements are the same thing with different process boundaries.
WORKER_THREADS=1
WORKER_POLL_SECONDS=1.0
JOB_LEASE_SECONDS=90.0

# Run outstanding migrations on boot. Turn off where a deploy pipeline runs
# `alembic upgrade head` as its own step and the app should not race it.
AUTO_MIGRATE=true

LOG_LEVEL=INFO
LOG_JSON=true
