# Copy to backend/.env for local (non-Docker) runs.
DATABASE_URL=postgresql+psycopg2://astra:astra@localhost:5432/astrasynth

# Optional. Without it, mission reports fall back to the deterministic
# template - every number is identical, only the prose is missing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Terrain interpretation. Set these from the sidecar JSON that
# scripts/prepare_usgs_terrain.py writes when using real USGS DEM tiles.
METERS_PER_PIXEL=2.0
ELEVATION_RANGE_M=40.0

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
